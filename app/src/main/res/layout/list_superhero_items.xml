<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_height"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/image_width"
        android:layout_height="@dimen/image_height"
        android:scaleType="fitCenter"
        android:contentDescription="@string/image_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:srcCompat="@tools:sample/avatars"/>
    <TextView
        android:id="@+id/txtName"
        android:layout_width="@dimen/text_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/text_name_desc_marginTop"
        android:layout_marginStart="@dimen/text_name_desc_slug_marginStar"
        android:textSize="@dimen/text_name_size"
        android:text="@string/name_superhero"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imageView"/>

    <TextView
        android:id="@+id/txtDesc"
        android:layout_width="@dimen/text_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/text_name_desc_slug_marginStar"
        android:layout_marginTop="24dp"
        android:text="@string/description_superhero"
        android:textSize="@dimen/text_des_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/imageView"
        app:layout_constraintTop_toBottomOf="@id/txtName" />

    <TextView
        android:id="@+id/txtSlug"
        android:layout_width="@dimen/text_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/text_name_desc_slug_marginStar"
        android:layout_marginTop="40dp"
        android:text="@string/slug_superhero"
        android:textSize="@dimen/text_slug_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/imageView"
        app:layout_constraintTop_toBottomOf="@id/txtDesc" />
</androidx.constraintlayout.widget.ConstraintLayout>